# The host your school's WebUntis lives on, and its login name.
# Find both by searching your school at https://webuntis.com — the URL it
# sends you to looks like https://<server>/WebUntis/?school=<school>
UNTIS_SERVER=example.webuntis.com
UNTIS_SCHOOL=example-school
UNTIS_USER=
UNTIS_PASS=
UNTIS_TZ=Europe/Vienna
